# Copy this file to .env and fill in your values
# Never commit your actual .env file

# Port for backend server
PORT=5000

# LLM API Key (CampusOS dynamically supports Google Gemini, OpenAI, or Groq)
# Provide whichever key you have available:
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (Optional)
# If provided, connects to MongoDB. If omitted, seamlessly runs embedded persistent storage.
MONGODB_URI=mongodb://127.0.0.1:27017/campusos
